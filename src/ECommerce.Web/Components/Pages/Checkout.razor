@page "/checkout"
@inject CartService CartService
@inject AuthService AuthService
@inject OrderService OrderService
@inject InventoryService InventoryService
@inject NavigationManager Navigation

<div class="container py-4">
    <h1 class="mb-4"><i class="bi bi-credit-card me-2"></i>Checkout</h1>

    @if (!isAuthenticated)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>Please <a href="/login">log in</a> to complete your order.
        </div>
    }
    else if (cart == null || !cart.Items.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Your cart is empty. <a href="/products">Browse products</a>
        </div>
    }
    else
    {
        @if (stockIssues.Any())
        {
            <div class="alert alert-danger mb-4">
                <i class="bi bi-exclamation-octagon me-2"></i>
                <strong>Cannot proceed - Stock issues detected:</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var issue in stockIssues)
                    {
                        <li>@issue</li>
                    }
                </ul>
                <div class="mt-3">
                    <a href="/cart" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-arrow-left me-1"></i>Return to Cart
                    </a>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-8">
                <!-- Shipping Address -->
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-geo-alt me-2"></i>Shipping Address
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Street Address</label>
                                <input type="text" class="form-control" @bind="shippingAddress" placeholder="123 Main St">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">City</label>
                                <input type="text" class="form-control" @bind="city" placeholder="Toronto">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Postal Code</label>
                                <input type="text" class="form-control" @bind="postalCode" placeholder="M5H 2N2">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Country</label>
                                <input type="text" class="form-control" @bind="country" placeholder="Canada">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Items -->
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <strong>Order Items</strong>
                    </div>
                    <div class="card-body p-0">
                        <table class="table mb-0">
                            <tbody>
                                @foreach (var item in cart.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@item.ImageUrl" alt="@item.ProductName" class="me-3 rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                                <div>
                                                    <strong>@item.ProductName</strong>
                                                    <br><small class="text-muted">Qty: @item.Quantity</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end align-middle">$@item.Subtotal.ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <strong>Order Summary</strong>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span>$@cart.Subtotal.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax (13% HST)</span>
                            <span>$@cart.Tax.ToString("F2")</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total</strong>
                            <strong class="text-primary">$@cart.Total.ToString("F2")</strong>
                        </div>
                        <button class="btn btn-success w-100" @onclick="PlaceOrderAsync" disabled="@(isProcessing || stockIssues.Any())">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Processing...</span>
                            }
                            else if (stockIssues.Any())
                            {
                                <i class="bi bi-x-circle me-2"></i>
                                <span>Stock Unavailable</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle me-2"></i>
                                <span>Place Order</span>
                            }
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-3">
                        <i class="bi bi-exclamation-circle me-2"></i>@errorMessage
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private ShoppingCart? cart;
    private bool isAuthenticated = false;
    private bool isProcessing = false;
    private string errorMessage = "";
    private string shippingAddress = "";
    private string city = "";
    private string postalCode = "";
    private string country = "";
    private List<string> stockIssues = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isAuthenticated = await AuthService.IsAuthenticatedAsync();
            
            if (isAuthenticated)
            {
                cart = await CartService.GetCartAsync();
                
                // Check stock availability
                await CheckStockAvailabilityAsync();
                
                var user = await AuthService.GetCurrentUserAsync();
                if (user != null)
                {
                    // Pre-fill with default values
                    shippingAddress = "123 Main St";
                    city = "Toronto";
                    postalCode = "M5H 2N2";
                    country = "Canada";
                }
            }
        }
        catch
        {
            // Ignore errors
        }
    }

    private async Task CheckStockAvailabilityAsync()
    {
        stockIssues.Clear();

        if (cart == null || !cart.Items.Any()) return;

        try
        {
            var checkItems = cart.Items.Select(i => new StockCheckRequestItem
            {
                ProductId = i.ProductId,
                Quantity = i.Quantity
            }).ToList();

            var result = await InventoryService.CheckStockAsync(checkItems);

            if (result != null)
            {
                foreach (var item in result.Items)
                {
                    if (!item.IsAvailable)
                    {
                        var cartItem = cart.Items.FirstOrDefault(c => c.ProductId == item.ProductId);
                        if (cartItem != null)
                        {
                            if (item.AvailableQuantity == 0)
                            {
                                stockIssues.Add($"{cartItem.ProductName} is out of stock.");
                            }
                            else
                            {
                                stockIssues.Add($"{cartItem.ProductName}: Only {item.AvailableQuantity} available (you requested {item.RequestedQuantity}).");
                            }
                        }
                    }
                }
            }
        }
        catch
        {
            // Ignore stock check errors - will be caught during order placement
        }
    }

    private async Task PlaceOrderAsync()
    {
        if (string.IsNullOrWhiteSpace(shippingAddress) || string.IsNullOrWhiteSpace(city) ||
            string.IsNullOrWhiteSpace(postalCode) || string.IsNullOrWhiteSpace(country))
        {
            errorMessage = "Please fill in all shipping address fields.";
            return;
        }

        if (stockIssues.Any())
        {
            errorMessage = "Please resolve stock availability issues before placing your order.";
            return;
        }

        isProcessing = true;
        errorMessage = "";

        try
        {
            var orderRequest = new CreateOrderRequest
            {
                Items = cart!.Items.Select(i => new CreateOrderItemRequest
                {
                    ProductId = i.ProductId,
                    ProductName = i.ProductName,
                    Quantity = i.Quantity,
                    UnitPrice = i.Price
                }).ToList(),
                ShippingAddress = shippingAddress,
                City = city,
                PostalCode = postalCode,
                Country = country
            };

            var (success, error, order) = await OrderService.CreateOrderAsync(orderRequest);

            if (success && order != null)
            {
                await CartService.ClearCartAsync();
                Navigation.NavigateTo($"/orders/{order.OrderNumber}");
            }
            else
            {
                errorMessage = error ?? "Failed to place order. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
}
