@page "/profile"
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="container py-4">
    <h1 class="mb-4"><i class="bi bi-person me-2"></i>My Profile</h1>

    @if (!isAuthenticated)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>Please <a href="/login">log in</a> to view your profile.
        </div>
    }
    else if (user == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-4 mb-4">
                <div class="card">
                    <div class="card-body text-center">
                        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px; font-size: 2.5rem;">
                            @(user.FirstName[0])@(user.LastName.Length > 0 ? user.LastName[0] : "")
                        </div>
                        <h4>@user.FirstName @user.LastName</h4>
                        <p class="text-muted">@user.Email</p>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header">Quick Links</div>
                    <div class="list-group list-group-flush">
                        <a href="/orders" class="list-group-item list-group-item-action">
                            <i class="bi bi-box me-2"></i>My Orders
                        </a>
                        <a href="/cart" class="list-group-item list-group-item-action">
                            <i class="bi bi-cart me-2"></i>Shopping Cart
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-person-gear me-2"></i>Account Information
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">First Name</label>
                                <input type="text" class="form-control" value="@user.FirstName" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Last Name</label>
                                <input type="text" class="form-control" value="@user.LastName" readonly>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" value="@user.Email" readonly>
                            </div>
                        </div>

                        <hr class="my-4">

                        <h5 class="mb-3">Membership Since</h5>
                        <p class="text-muted">@DateTime.Now.Year</p>

                        <div class="d-flex gap-2 mt-4">
                            <button class="btn btn-outline-danger" @onclick="LogoutAsync">
                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isAuthenticated = false;
    private AuthResponse? user;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (isAuthenticated)
        {
            user = await AuthService.GetCurrentUserAsync();
        }
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}
