@page "/cart"
@inject CartService CartService
@inject AuthService AuthService
@inject InventoryService InventoryService
@inject NavigationManager Navigation

<div class="container py-4">
    <h1 class="mb-4"><i class="bi bi-cart3 me-2"></i>Shopping Cart</h1>

    @if (cart == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!cart.Items.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted mb-4"></i>
            <h3 class="text-muted">Your cart is empty</h3>
            <p class="text-muted">Add some products to get started!</p>
            <a href="/products" class="btn btn-primary mt-3">
                <i class="bi bi-grid me-2"></i>Browse Products
            </a>
        </div>
    }
    else
    {
        @if (stockIssues.Any())
        {
            <div class="alert alert-warning mb-4">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>Stock availability issues:</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var issue in stockIssues)
                    {
                        <li>@issue</li>
                    }
                </ul>
            </div>
        }

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <strong>Cart Items (@cart.Items.Count)</strong>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-center">Price</th>
                                        <th class="text-center">Quantity</th>
                                        <th class="text-end">Subtotal</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in cart.Items)
                                    {
                                        var stockStatus = GetStockStatus(item.ProductId);
                                        <tr class="@(stockStatus.HasIssue ? "table-warning" : "")">
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="me-3 rounded" style="width: 60px; height: 60px; object-fit: cover;">
                                                    <div>
                                                        <a href="/products/@item.ProductId" class="text-decoration-none">@item.ProductName</a>
                                                        @if (stockStatus.HasIssue)
                                                        {
                                                            <br><small class="text-danger"><i class="bi bi-exclamation-circle"></i> @stockStatus.Message</small>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center align-middle">$@item.Price.ToString("F2")</td>
                                            <td class="text-center align-middle">
                                                <div class="input-group input-group-sm justify-content-center" style="width: 120px; margin: 0 auto;">
                                                    <button class="btn btn-outline-secondary" @onclick="() => UpdateQuantityAsync(item.ProductId, item.Quantity - 1)">
                                                        <i class="bi bi-dash"></i>
                                                    </button>
                                                    <input type="text" class="form-control text-center" value="@item.Quantity" readonly>
                                                    <button class="btn btn-outline-secondary" @onclick="() => UpdateQuantityAsync(item.ProductId, item.Quantity + 1)">
                                                        <i class="bi bi-plus"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="text-end align-middle fw-bold">$@item.Subtotal.ToString("F2")</td>
                                            <td class="text-end align-middle">
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveItemAsync(item.ProductId)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="/products" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                    </a>
                    <button class="btn btn-outline-danger" @onclick="ClearCartAsync">
                        <i class="bi bi-trash me-2"></i>Clear Cart
                    </button>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <strong>Order Summary</strong>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span>$@cart.Subtotal.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax (13% HST)</span>
                            <span>$@cart.Tax.ToString("F2")</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total</strong>
                            <strong class="text-primary">$@cart.Total.ToString("F2")</strong>
                        </div>
                        <button class="btn btn-primary w-100" @onclick="ProceedToCheckoutAsync">
                            <i class="bi bi-credit-card me-2"></i>Proceed to Checkout
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert alert-warning mt-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>@message
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private ShoppingCart? cart;
    private string message = "";
    private List<string> stockIssues = new();
    private Dictionary<int, StockCheckItem> stockCheckResults = new();

    protected override async Task OnInitializedAsync()
    {
        CartService.OnCartChanged += HandleCartChanged;
        await LoadCartAsync();
    }

    private async void HandleCartChanged()
    {
        await LoadCartAsync();
    }

    private async Task LoadCartAsync()
    {
        try
        {
            cart = await CartService.GetCartAsync();
            await CheckStockAvailabilityAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Ignore errors
        }
    }

    private async Task CheckStockAvailabilityAsync()
    {
        stockIssues.Clear();
        stockCheckResults.Clear();

        if (cart == null || !cart.Items.Any()) return;

        try
        {
            var checkItems = cart.Items.Select(i => new StockCheckRequestItem
            {
                ProductId = i.ProductId,
                Quantity = i.Quantity
            }).ToList();

            var result = await InventoryService.CheckStockAsync(checkItems);

            if (result != null)
            {
                foreach (var item in result.Items)
                {
                    stockCheckResults[item.ProductId] = item;

                    if (!item.IsAvailable)
                    {
                        var cartItem = cart.Items.FirstOrDefault(c => c.ProductId == item.ProductId);
                        if (cartItem != null)
                        {
                            if (item.AvailableQuantity == 0)
                            {
                                stockIssues.Add($"{cartItem.ProductName} is out of stock.");
                            }
                            else
                            {
                                stockIssues.Add($"{cartItem.ProductName}: Only {item.AvailableQuantity} available (you have {item.RequestedQuantity} in cart).");
                            }
                        }
                    }
                }
            }
        }
        catch
        {
            // Ignore stock check errors - proceed without warnings
        }
    }

    private (bool HasIssue, string Message) GetStockStatus(int productId)
    {
        if (stockCheckResults.TryGetValue(productId, out var stockItem))
        {
            if (!stockItem.IsAvailable)
            {
                if (stockItem.AvailableQuantity == 0)
                {
                    return (true, "Out of stock");
                }
                return (true, $"Only {stockItem.AvailableQuantity} available");
            }
        }
        return (false, "");
    }

    private async Task UpdateQuantityAsync(int productId, int quantity)
    {
        await CartService.UpdateQuantityAsync(productId, quantity);
    }

    private async Task RemoveItemAsync(int productId)
    {
        await CartService.RemoveFromCartAsync(productId);
    }

    private async Task ClearCartAsync()
    {
        await CartService.ClearCartAsync();
    }

    private async Task ProceedToCheckoutAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            message = "Please log in to proceed to checkout.";
            return;
        }

        if (stockIssues.Any())
        {
            message = "Please resolve stock issues before proceeding to checkout.";
            return;
        }

        Navigation.NavigateTo("/checkout");
    }
}
