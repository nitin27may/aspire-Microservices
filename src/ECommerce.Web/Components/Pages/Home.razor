@page "/"
@inject ProductService ProductService

<div class="container-fluid px-0">
    <!-- Hero Section -->
    <div class="bg-primary text-white py-5 mb-4">
        <div class="container text-center">
            <h1 class="display-4 fw-bold">Welcome to E-Commerce Demo</h1>
            <p class="lead">Explore our wide range of products across multiple categories</p>
            <a href="/products" class="btn btn-light btn-lg mt-3">
                <i class="bi bi-grid me-2"></i>Browse Products
            </a>
        </div>
    </div>

    <div class="container">
        <!-- Categories Section -->
        <section class="mb-5">
            <h2 class="mb-4"><i class="bi bi-collection me-2"></i>Shop by Category</h2>
            @if (categories == null)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-4">
                    @foreach (var category in categories)
                    {
                        <div class="col">
                            <a href="/products?categoryId=@category.Id" class="text-decoration-none">
                                <div class="card h-100 category-card">
                                    <div class="card-body text-center">
                                        <i class="bi @GetCategoryIcon(category.Name) display-4 text-primary mb-3"></i>
                                        <h5 class="card-title">@category.Name</h5>
                                        <p class="card-text text-muted small">@category.ProductCount products</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- Featured Products Section -->
        <section class="mb-5">
            <h2 class="mb-4"><i class="bi bi-star me-2"></i>Featured Products</h2>
            @if (featuredProducts == null)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
                    @foreach (var product in featuredProducts)
                    {
                        <div class="col">
                            <div class="card h-100 product-card">
                                <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;">
                                <div class="card-body d-flex flex-column">
                                    <span class="badge bg-secondary mb-2" style="width: fit-content;">@product.CategoryName</span>
                                    <h5 class="card-title">@product.Name</h5>
                                    <p class="card-text text-muted small flex-grow-1">@TruncateDescription(product.Description)</p>
                                    <div class="d-flex justify-content-between align-items-center mt-auto">
                                        <span class="h5 mb-0 text-primary">$@product.Price.ToString("F2")</span>
                                        <a href="/products/@product.Id" class="btn btn-outline-primary btn-sm">View Details</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- Why Shop With Us Section -->
        <section class="mb-5 py-4 bg-light rounded">
            <div class="container">
                <h2 class="text-center mb-4">Why Shop With Us</h2>
                <div class="row g-4">
                    <div class="col-md-4 text-center">
                        <i class="bi bi-truck display-4 text-primary mb-3"></i>
                        <h5>Fast Shipping</h5>
                        <p class="text-muted">Free shipping on orders over $50</p>
                    </div>
                    <div class="col-md-4 text-center">
                        <i class="bi bi-shield-check display-4 text-primary mb-3"></i>
                        <h5>Secure Payment</h5>
                        <p class="text-muted">Your payment information is safe</p>
                    </div>
                    <div class="col-md-4 text-center">
                        <i class="bi bi-arrow-repeat display-4 text-primary mb-3"></i>
                        <h5>Easy Returns</h5>
                        <p class="text-muted">30-day return policy</p>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private IEnumerable<CategoryDto>? categories;
    private IEnumerable<ProductDto>? featuredProducts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await ProductService.GetCategoriesAsync();
            featuredProducts = await ProductService.GetFeaturedProductsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading home page: {ex.Message}");
        }
    }

    private string GetCategoryIcon(string categoryName) => categoryName switch
    {
        "Electronics" => "bi-laptop",
        "Clothing" => "bi-bag",
        "Home & Garden" => "bi-house",
        "Sports & Outdoors" => "bi-bicycle",
        "Books" => "bi-book",
        _ => "bi-grid"
    };

    private string TruncateDescription(string description)
    {
        return description.Length > 80 ? description[..77] + "..." : description;
    }
}
