@page "/products"
@page "/products/{ProductId:int?}"
@inject ProductService ProductService
@inject CartService CartService
@inject InventoryService InventoryService
@inject NavigationManager Navigation

@if (ProductId.HasValue)
{
    <!-- Product Detail View -->
    <div class="container py-4">
        @if (selectedProduct == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/products">Products</a></li>
                    <li class="breadcrumb-item active">@selectedProduct.Name</li>
                </ol>
            </nav>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <img src="@selectedProduct.ImageUrl" class="img-fluid rounded shadow" alt="@selectedProduct.Name">
                </div>
                <div class="col-md-6">
                    <span class="badge bg-secondary mb-2">@selectedProduct.CategoryName</span>
                    <h1>@selectedProduct.Name</h1>
                    <p class="lead text-muted">@selectedProduct.Description</p>
                    <h2 class="text-primary mb-4">$@selectedProduct.Price.ToString("F2")</h2>

                    @if (inventory != null)
                    {
                        @if (inventory.AvailableStock > 0)
                        {
                            <p class="text-success"><i class="bi bi-check-circle me-1"></i>In Stock (@inventory.AvailableStock available)</p>
                        }
                        else
                        {
                            <p class="text-danger"><i class="bi bi-x-circle me-1"></i>Out of Stock</p>
                        }
                    }

                    <div class="mb-4">
                        <label class="form-label">Quantity</label>
                        <select class="form-select w-auto" @bind="quantity">
                            @for (int i = 1; i <= 10; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-lg" @onclick="AddToCartAsync" disabled="@(inventory?.AvailableStock == 0)">
                            <i class="bi bi-cart-plus me-2"></i>Add to Cart
                        </button>
                        <a href="/products" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-arrow-left me-2"></i>Back to Products
                        </a>
                    </div>

                    @if (addedToCart)
                    {
                        <div class="alert alert-success mt-3">
                            <i class="bi bi-check-circle me-2"></i>Added to cart!
                            <a href="/cart" class="alert-link ms-2">View Cart</a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Products List View -->
    <div class="container py-4">
        <div class="row">
            <!-- Sidebar Filters -->
            <div class="col-md-3 mb-4">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-funnel me-2"></i>Filters
                    </div>
                    <div class="card-body">
                        <h6>Categories</h6>
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <a href="/products" class="text-decoration-none @(selectedCategoryId == null ? "fw-bold text-primary" : "text-dark")">
                                    All Categories
                                </a>
                            </li>
                            @if (categories != null)
                            {
                                @foreach (var cat in categories)
                                {
                                    <li class="mb-2">
                                        <a href="/products?categoryId=@cat.Id" class="text-decoration-none @(selectedCategoryId == cat.Id ? "fw-bold text-primary" : "text-dark")">
                                            @cat.Name (@cat.ProductCount)
                                        </a>
                                    </li>
                                }
                            }
                        </ul>

                        <hr>

                        <h6>Sort By</h6>
                        <select class="form-select" @bind="sortBy" @bind:after="LoadProductsAsync">
                            <option value="">Newest First</option>
                            <option value="price_asc">Price: Low to High</option>
                            <option value="price_desc">Price: High to Low</option>
                            <option value="name_asc">Name: A-Z</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Products Grid -->
            <div class="col-md-9">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="mb-0">Products</h1>
                    <div class="input-group" style="max-width: 300px;">
                        <input type="text" class="form-control" placeholder="Search products..." @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearch">
                        <button class="btn btn-outline-primary" @onclick="LoadProductsAsync">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>

                @if (products == null)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!products.Items.Any())
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>No products found.
                    </div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                        @foreach (var product in products.Items)
                        {
                            <div class="col">
                                <div class="card h-100 product-card">
                                    <a href="/products/@product.Id" class="text-decoration-none">
                                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 180px; object-fit: cover;">
                                    </a>
                                    <div class="card-body d-flex flex-column">
                                        <span class="badge bg-secondary mb-2" style="width: fit-content;">@product.CategoryName</span>
                                        <a href="/products/@product.Id" class="text-decoration-none text-dark">
                                            <h5 class="card-title">@product.Name</h5>
                                        </a>
                                        <p class="card-text text-muted small flex-grow-1">@TruncateDescription(product.Description)</p>
                                        <div class="d-flex justify-content-between align-items-center mt-auto">
                                            <span class="h5 mb-0 text-primary">$@product.Price.ToString("F2")</span>
                                            <button class="btn btn-primary btn-sm" @onclick="() => QuickAddToCartAsync(product)">
                                                <i class="bi bi-cart-plus"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Pagination -->
                    @if (products.TotalPages > 1)
                    {
                        <nav class="mt-4">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Previous</button>
                                </li>
                                @for (int i = 1; i <= products.TotalPages; i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                                    </li>
                                }
                                <li class="page-item @(currentPage == products.TotalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? ProductId { get; set; }
    [SupplyParameterFromQuery] public int? categoryId { get; set; }

    private IEnumerable<CategoryDto>? categories;
    private PaginatedResponse<ProductDto>? products;
    private ProductDto? selectedProduct;
    private InventoryDto? inventory;
    private int? selectedCategoryId;
    private string searchQuery = "";
    private string sortBy = "";
    private int currentPage = 1;
    private int quantity = 1;
    private bool addedToCart = false;

    protected override async Task OnInitializedAsync()
    {
        categories = await ProductService.GetCategoriesAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        selectedCategoryId = categoryId;

        if (ProductId.HasValue)
        {
            selectedProduct = await ProductService.GetProductByIdAsync(ProductId.Value);
            if (selectedProduct != null)
            {
                inventory = await InventoryService.GetInventoryAsync(ProductId.Value);
            }
        }
        else
        {
            await LoadProductsAsync();
        }
    }

    private async Task LoadProductsAsync()
    {
        products = await ProductService.GetProductsAsync(selectedCategoryId, searchQuery, sortBy, currentPage, 10);
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            currentPage = 1;
            await LoadProductsAsync();
        }
    }

    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadProductsAsync();
    }

    private async Task AddToCartAsync()
    {
        if (selectedProduct != null)
        {
            await CartService.AddToCartAsync(selectedProduct, quantity);
            addedToCart = true;
            StateHasChanged();
            await Task.Delay(3000);
            addedToCart = false;
            StateHasChanged();
        }
    }

    private async Task QuickAddToCartAsync(ProductDto product)
    {
        await CartService.AddToCartAsync(product);
    }

    private string TruncateDescription(string description)
    {
        return description.Length > 60 ? description[..57] + "..." : description;
    }
}
