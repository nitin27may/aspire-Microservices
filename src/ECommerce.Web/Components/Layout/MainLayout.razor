@inherits LayoutComponentBase
@inject AuthService AuthService
@inject CartService CartService
@inject NavigationManager Navigation

<div class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-cart3 me-2"></i>E-Commerce Demo
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/products">Products</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link position-relative" href="/cart">
                            <i class="bi bi-cart3"></i> Cart
                            @if (cartCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @cartCount
                                </span>
                            }
                        </a>
                    </li>
                    @if (isAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i> @userName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                                <li><a class="dropdown-item" href="/orders"><i class="bi bi-box me-2"></i>My Orders</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="#" @onclick="LogoutAsync"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        @Body
    </main>

    <footer class="bg-dark text-white py-4 mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5><i class="bi bi-cart3 me-2"></i>E-Commerce Demo</h5>
                    <p class="text-muted">A demonstration of microservices architecture with .NET Aspire</p>
                </div>
                <div class="col-md-4">
                    <h6>Quick Links</h6>
                    <ul class="list-unstyled">
                        <li><a href="/products" class="text-muted text-decoration-none">Products</a></li>
                        <li><a href="/cart" class="text-muted text-decoration-none">Cart</a></li>
                        <li><a href="/orders" class="text-muted text-decoration-none">Orders</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6>Technology</h6>
                    <ul class="list-unstyled text-muted">
                        <li><i class="bi bi-dot"></i> .NET 10 & Aspire</li>
                        <li><i class="bi bi-dot"></i> Blazor Server</li>
                        <li><i class="bi bi-dot"></i> PostgreSQL & Redis</li>
                        <li><i class="bi bi-dot"></i> RabbitMQ</li>
                    </ul>
                </div>
            </div>
            <hr class="my-3">
            <div class="text-center text-muted">
                <small>&copy; 2024 E-Commerce Demo. Built with .NET Aspire.</small>
            </div>
        </div>
    </footer>
</div>

@code {
    private bool isAuthenticated = false;
    private string userName = "";
    private int cartCount = 0;

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnAuthStateChanged += async () => await UpdateAuthStateAsync();
        CartService.OnCartChanged += async () => await UpdateCartCountAsync();
        
        await UpdateAuthStateAsync();
        await UpdateCartCountAsync();
    }

    private async Task UpdateAuthStateAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (isAuthenticated)
        {
            var user = await AuthService.GetCurrentUserAsync();
            userName = user?.FirstName ?? "User";
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateCartCountAsync()
    {
        cartCount = await CartService.GetCartCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}
