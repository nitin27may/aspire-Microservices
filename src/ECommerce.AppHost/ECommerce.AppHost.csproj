<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <SuppressNETWorkloadWarnings>true</SuppressNETWorkloadWarnings>
    <!-- Intentionally not using the Aspire CLI bundle: `dotnet run` on this project works without installing the separate Aspire CLI. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECommerce.ProductCatalog.Api\ECommerce.ProductCatalog.Api.csproj" />
    <ProjectReference Include="..\ECommerce.UserManagement.Api\ECommerce.UserManagement.Api.csproj" />
    <ProjectReference Include="..\ECommerce.Orders.Api\ECommerce.Orders.Api.csproj" />
    <ProjectReference Include="..\ECommerce.Inventory.Api\ECommerce.Inventory.Api.csproj" />
    <ProjectReference Include="..\ECommerce.Notifications.Api\ECommerce.Notifications.Api.csproj" />
    <ProjectReference Include="..\ECommerce.Web\ECommerce.Web.csproj" />
  </ItemGroup>

</Project>
